PORT=4000
DATABASE_URL=postgres://menuapp:menuapp@localhost:5432/menuapp
# Forzar SSL en la conexión a Postgres. Se activa solo automáticamente para
# hosts remotos (Neon, Render, etc.); en localhost no hace falta tocar esto.
PGSSL=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Opcional: si está seteada, el importador de recetas usa la API de Anthropic
# como fallback cuando no hay JSON-LD y el scraping heurístico falla.
ANTHROPIC_API_KEY=
